# Copy to .env on GPU server (or export in shell).
# MLflow backend on server (default: local sqlite in bundle root)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=final_rings_for_paper

# Training
REQUIRE_ZHENG_PROTOCOL=1
CUDA_VISIBLE_DEVICES=0

# Optional: stream MLflow to laptop (see README — SSH tunnel)
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Sync back to laptop (used by sync_results_to_laptop.sh)
# LAPTOP=user@your-laptop
# REMOTE_DIR=~/final_rings_for_paper
